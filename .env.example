# Local development only. Copy this file to .env and change credentials if the
# services are exposed beyond localhost.

# PostgreSQL
POSTGRES_USER=youtube_clone
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=youtube_clone
POSTGRES_PORT=5432
DATABASE_URL=postgresql://youtube_clone:change-me-local-postgres@localhost:5432/youtube_clone?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally)
MINIO_ROOT_USER=youtube_clone
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=youtube_clone
S3_SECRET_KEY=change-me-local-minio-password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ORIGINALS=video-originals
S3_BUCKET_STREAMS=video-streams
S3_BUCKET_THUMBNAILS=video-thumbnails

# Application URLs and ports
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication and development seed. Production seeding requires an explicit
# DEV_SEED_PASSWORD; the value below is only the local development default.
SESSION_COOKIE_NAME=ytc_session
DEV_SEED_PASSWORD=youtube-clone-dev
SESSION_TTL_SECONDS=604800

# Upload and media-worker limits
MAX_UPLOAD_SIZE_BYTES=2147483648
WORKER_CONCURRENCY=1
WORKER_HEALTH_PORT=4001
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_PROCESS_TIMEOUT_MS=900000
MAX_VIDEO_DURATION_SECONDS=7200
