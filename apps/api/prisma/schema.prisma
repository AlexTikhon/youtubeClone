generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  DRAFT
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETING
}

enum VideoVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum VideoAssetKind {
  ORIGINAL
  THUMBNAIL
  HLS_MANIFEST
  HLS_RENDITION
}

enum UploadStatus {
  PENDING
  COMPLETED
}

enum PlaylistVisibility {
  PRIVATE
  PUBLIC
}

enum PlaylistType {
  STANDARD
  WATCH_LATER
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(320)
  username     String        @unique @db.VarChar(50)
  passwordHash String        @db.VarChar(255)
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  channel      Channel?
  authSessions AuthSession[]
  likes        VideoLike[]
  comments     Comment[]
  subscriptions Subscription[] @relation("SubscriberSubscriptions")
  videoViews   VideoView[]
  watchHistory WatchHistory[]
  playlists    Playlist[]
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Channel {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @unique @db.Uuid
  handle      String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(1000)
  avatarUrl   String?
  bannerUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  videos      Video[]
  subscriptions Subscription[]
}

model Video {
  id              String          @id @default(uuid()) @db.Uuid
  channelId       String          @db.Uuid
  title           String          @db.VarChar(120)
  description     String?         @db.VarChar(5000)
  status          VideoStatus     @default(DRAFT)
  visibility      VideoVisibility @default(PRIVATE)
  durationSeconds Int?
  width           Int?
  height          Int?
  publishedAt     DateTime?
  failureReason   String?         @db.VarChar(500)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  channel         Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  assets          VideoAsset[]
  upload          VideoUpload?
  likes           VideoLike[]
  comments        Comment[]
  views           VideoView[]
  watchHistory    WatchHistory[]
  playlistItems   PlaylistItem[]

  @@index([channelId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@index([status, visibility, publishedAt(sort: Desc), id(sort: Desc)])
}

model VideoLike {
  userId    String   @db.Uuid
  videoId   String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  videoId   String   @db.Uuid
  authorId  String   @db.Uuid
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
}

model Subscription {
  subscriberId String   @db.Uuid
  channelId    String   @db.Uuid
  createdAt    DateTime @default(now())
  subscriber   User     @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([subscriberId, channelId])
  @@index([channelId])
  @@index([subscriberId, createdAt(sort: Desc)])
}

model VideoView {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  videoId     String   @db.Uuid
  windowStart DateTime
  viewedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId, windowStart])
  @@index([videoId, viewedAt(sort: Desc)])
}

model WatchHistory {
  userId              String   @db.Uuid
  videoId             String   @db.Uuid
  lastPositionSeconds Int
  lastWatchedAt       DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video                Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([userId, lastWatchedAt(sort: Desc), videoId(sort: Desc)])
}

model VideoUpload {
  id                String       @id @default(uuid()) @db.Uuid
  videoId           String       @unique @db.Uuid
  bucket            String       @db.VarChar(100)
  objectKey         String       @db.VarChar(1024)
  contentType       String       @db.VarChar(255)
  expectedSizeBytes BigInt?
  status            UploadStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  completedAt       DateTime?
  video             Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([bucket, objectKey])
}

model VideoAsset {
  id             String         @id @default(uuid()) @db.Uuid
  videoId        String         @db.Uuid
  kind           VideoAssetKind
  bucket         String         @db.VarChar(100)
  objectKey      String         @db.VarChar(1024)
  mimeType       String         @db.VarChar(255)
  sizeBytes      BigInt?
  width          Int?
  height         Int?
  bitrateKbps    Int?
  durationSeconds Int?
  metadata       Json?
  createdAt      DateTime       @default(now())
  video          Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([bucket, objectKey])
  @@index([videoId, kind])
}

model Playlist {
  id          String             @id @default(uuid()) @db.Uuid
  ownerId     String             @db.Uuid
  title       String             @db.VarChar(120)
  description String?            @db.VarChar(1000)
  visibility  PlaylistVisibility @default(PRIVATE)
  type        PlaylistType       @default(STANDARD)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]

  @@index([ownerId, updatedAt(sort: Desc), id(sort: Desc)])
}

model PlaylistItem {
  playlistId String   @db.Uuid
  videoId    String   @db.Uuid
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([playlistId, videoId])
  @@unique([playlistId, position])
  @@index([videoId])
}
